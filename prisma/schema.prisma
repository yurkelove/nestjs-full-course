generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Movie {
  id String @id @default(uuid())

  title       String
  description String?
  releaseYear Int     @map("repease_year")

  rating Float @default(0.0)

  isAvailable Boolean @default(false) @map("is_available")

  genre Genre @default(DRAMA)

  // Связь

  //One to one
  poster   Poster? @relation(fields: [posterId], references: [id])
  posterId String? @unique @map("poster_id")

  //One to many
  reviews Review[] @relation("movie_reviews")
  //Many to many
  actors  Actor[]  @relation("movie_actors")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("movies") //database name
}

//Decorators
// @@index([releaseYear, title]) // Ускорить запросы
// @@ignore проигнорировать поле для призмы
// @@unique([movieId, userId]) - один пользователь может оставить отзыв только к одному фильму

//One to one
model Poster {
  id String @id @default(uuid())

  url String

  movie Movie? @relation()

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("movie_posters") //database name
}

//One to many
model Review {
  id String @id @default(uuid())

  text   String
  rating Decimal @default(0.0)

  //Связь
  movie   Movie  @relation("movie_reviews", fields: [movieId], references: [id], onDelete: Cascade)
  movieId String @map("movie_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reviews") //database name
}

//Many to many 
model Actor {
  id String @id @default(uuid())

  name String

  movies Movie[] @relation("movie_actors")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("actors") //database name
}

//Create enum
enum Genre {
  ACTION
  COMEDY
  DRAMA
  HOROR

  @@map("enum_genres")
}
